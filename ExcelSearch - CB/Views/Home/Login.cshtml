@model ExcelSearch___CB.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var config = ViewBag.AppConfig as ExcelSearch___CB.Data.AppConfig;
    var strings = ViewBag.UIStrings as System.Collections.Generic.Dictionary<string, string> ?? new System.Collections.Generic.Dictionary<string, string>();
    
    string GetString(string key, string defaultValue = "") {
        return strings.ContainsKey(key) ? strings[key] : defaultValue;
    }
}

<link href="~/Content/Login.css" rel="stylesheet" />

<section class="login-page">

    <div class="login-wrapper">


        <!-- LEFT PANEL -->

        <div class="login-left">

            <div class="brand">

                <div class="brand-icon">
                    <span class="glyphicon glyphicon-search"></span>
                </div>

                <h1>@GetString("login_brand_title", config?.AppName ?? "Excel Search Pro")</h1>

                <h3>@GetString("login_brand_subtitle", config?.CompanyName + " Real Estate Platform")</h3>

                <p>
                    @GetString("login_description", config?.AppDescription ?? "Search, manage and export real estate records efficiently.")
                </p>

            </div>


            <div class="feature-list">

                <div class="feature">
                    <span class="glyphicon glyphicon-ok-circle"></span>
                    <span>@GetString("login_feature1", "Fast Data Search")</span>
                </div>


                <div class="feature">
                    <span class="glyphicon glyphicon-ok-circle"></span>
                    <span>@GetString("login_feature2", "Excel & CSV Indexing")</span>
                </div>


                <div class="feature">
                    <span class="glyphicon glyphicon-ok-circle"></span>
                    <span>@GetString("login_feature3", "Export Search Results")</span>
                </div>


                <div class="feature">
                    <span class="glyphicon glyphicon-ok-circle"></span>
                    <span>@GetString("login_feature4", config?.CompanyName + " Internal System")</span>
                </div>

            </div>

        </div>





        <!-- RIGHT PANEL -->

        <div class="login-right">

            <div class="login-card">

                <div class="back-button">

                    <a href="@Url.Action("Index","Home")">
                        <span class="glyphicon glyphicon-arrow-left"></span>
                        @GetString("login_back", "Back")
                    </a>

                </div>

                <div class="login-header">

                    <h2>@GetString("login_title", "Welcome Back")</h2>

                    <p>
                        @GetString("login_subtitle", "Login to " + (config?.AppName ?? "Excel Search Pro"))
                    </p>

                </div>



                @using (Html.BeginForm("Login", "Home", FormMethod.Post))
                {

                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom:15px;display:block;color:#d9534f;" })

                    <div class="form-group">

                        <label>@GetString("login_username_label", "Username")</label>


                        @Html.TextBoxFor(m => m.Username,
                                  new
                                  {
                                      @class = "form-control",
                                      placeholder = GetString("login_username_placeholder", "Enter username")
                                  })


                        @Html.ValidationMessageFor(m => m.Username)

                    </div>




                    <div class="form-group">

                        <label>@GetString("login_password_label", "Password")</label>


                        @Html.PasswordFor(m => m.Password,
                                  new
                                  {
                                      @class = "form-control",
                                      placeholder = GetString("login_password_placeholder", "Enter password")
                                  })


                        @Html.ValidationMessageFor(m => m.Password)

                    </div>




                    <div class="login-options">


                        <label>

                            @Html.CheckBoxFor(m => m.RememberMe)

                            @GetString("login_remember", "Remember Me")

                        </label>


                    </div>





                    <button class="login-btn" type="submit">


                        <span class="glyphicon glyphicon-log-in"></span>

                        @GetString("login_button", "Login")


                    </button>


                }





                <div class="divider">
                    @GetString("login_or", "OR")
                </div>



                <div class="signup-link">

                    @GetString("login_no_account", "Don't have an account?")


                    <a href="@Url.Action("Signup","Home")">

                        @GetString("login_create_account", "Create Account")

                    </a>


                </div>



            </div>


        </div>


    </div>


</section>