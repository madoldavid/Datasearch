@{
    var config = ViewBag.AppConfig as ExcelSearch___CB.Data.AppConfig;
    var strings = ViewBag.UIStrings as System.Collections.Generic.Dictionary<string, string> ?? new System.Collections.Generic.Dictionary<string, string>();
    
    string GetString(string key, string defaultValue = "") {
        return strings.ContainsKey(key) ? strings[key] : defaultValue;
    }
}

<aside class="dashboard-sidebar" id="dashboardSidebar">

    <a href="@Url.Action("Index","UserDashboard")" class="dashboard-brand">

        <span class="brand-icon">
            @(config?.BrandIcon ?? "ESP")
        </span>

        <span>
            @GetString("user_sidebar_brand", config?.AppName ?? "Excel Search Pro")
        </span>

    </a>


    <a href="@Url.Action("Index","Home")" class="back-to-landing">
        @GetString("user_back_landing", "← Back to Landing Page")
    </a>


    <p class="sidebar-label">
        @GetString("user_section_workspace", "WORKSPACE")
    </p>


    <ul class="sidebar-menu">


        <li>
            <a href="@Url.Action("Index","UserDashboard")"
               class="@(ViewContext.RouteData.Values["action"].ToString()=="Index" ? "active":"")">

                <span class="glyphicon glyphicon-th-large"></span>

                @GetString("user_dashboard", "Dashboard")

            </a>
        </li>



        <li>

            <a href="@Url.Action("Search","UserDashboard")"
               class="@(ViewContext.RouteData.Values["action"].ToString()=="Search" ? "active":"")">


                <span class="glyphicon glyphicon-search"></span>

                @GetString("user_search", "Search")


            </a>

        </li>




        <li>

            <a href="@Url.Action("SearchResults","UserDashboard")"
               class="@(ViewContext.RouteData.Values["action"].ToString()=="SearchResults" ? "active":"")">


                <span class="glyphicon glyphicon-list-alt"></span>

                @GetString("user_search_results", "Search Results")


            </a>

        </li>




        <li>

            <a href="@Url.Action("MyExports","UserDashboard")"
               class="@(ViewContext.RouteData.Values["action"].ToString()=="MyExports" ? "active":"")">


                <span class="glyphicon glyphicon-export"></span>

                @GetString("user_my_exports", "My Exports")


            </a>

        </li>


    </ul>



    <div class="sidebar-footer">
        @GetString("user_footer", config?.CompanyName ?? "Coldwell Banker Real Estate")
        <br />
        @GetString("user_footer_sub", config?.FooterText ?? "Data Workspace")

        <form method="post" action="@Url.Action("Logout","Home")" style="margin-top:10px">
            @Html.AntiForgeryToken()
            <button type="submit" style="background:none;border:1px solid rgba(255,255,255,.3);color:rgba(255,255,255,.7);padding:6px 12px;border-radius:4px;font-size:11px;cursor:pointer">@GetString("user_logout", "Logout")</button>
        </form>
    </div>


</aside>