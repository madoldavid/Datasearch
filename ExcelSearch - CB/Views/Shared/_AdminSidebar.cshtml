@model ExcelSearch___CB.Models.AdminBaseViewModel
@{
    var config = ViewBag.AppConfig as ExcelSearch___CB.Data.AppConfig;
    var strings = ViewBag.UIStrings as System.Collections.Generic.Dictionary<string, string> ?? new System.Collections.Generic.Dictionary<string, string>();
    
    string GetString(string key, string defaultValue = "") {
        return strings.ContainsKey(key) ? strings[key] : defaultValue;
    }
}


<aside class="admin-sidebar">


    <div class="sidebar-logo">
        @GetString("admin_sidebar_logo", config?.AppName ?? "Excel Search Pro")
    </div>



    <div class="sidebar-section">
        @GetString("admin_section_pipeline", "PIPELINE")
    </div>



    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="Overview" ? "active":"")"
       href="@Url.Action("Overview","Admin")">

        <span class="glyphicon glyphicon-dashboard"></span>
        @GetString("admin_overview", "Overview")

    </a>




    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="Upload" ? "active":"")"
       href="@Url.Action("Upload","Admin")">

        <span class="glyphicon glyphicon-upload"></span>
        @GetString("admin_upload", "Upload Files")

    </a>





    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="IndexMonitor" ? "active":"")"
       href="@Url.Action("IndexMonitor","Admin")">

        <span class="glyphicon glyphicon-refresh"></span>
        @GetString("admin_index_monitor", "Index Monitor")

    </a>





    <div class="sidebar-section">
        @GetString("admin_section_data", "DATA")
    </div>





    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="AllFiles" ? "active":"")"
       href="@Url.Action("AllFiles","Admin")">

        <span class="glyphicon glyphicon-folder-open"></span>
        @GetString("admin_all_files", "All Files")

    </a>





    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="FailedFiles" ? "active":"")"
       href="@Url.Action("FailedFiles","Admin")">

        <span class="glyphicon glyphicon-warning-sign"></span>
        @GetString("admin_failed_files", "Failed Files")

    </a>






    <div class="sidebar-section">
        @GetString("admin_section_logs", "LOGS & HISTORY")
    </div>




    <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="SearchHistory" ? "active":"")"
       href="@Url.Action("SearchHistory","Admin")">
            <span class="glyphicon glyphicon-search"></span>
            @GetString("admin_search_history", "Search History")
        </a>





        <a class="sidebar-link"
           href="@Url.Action("ExportHistory","Admin")">

            <span class="glyphicon glyphicon-export"></span>

            @GetString("admin_export_history", "Export History")

        </a>





        <a class="sidebar-link @(ViewContext.RouteData.Values["action"].ToString()=="IndexingHistory"?"active":"")"
           href="@Url.Action("IndexingHistory","Admin")">
            <span class="glyphicon glyphicon-stats"></span>
            @GetString("admin_indexing_history", "Indexing History")
        </a>

        <a class="sidebar-link"
           href="@Url.Action("Storage","Admin")">

            <span class="glyphicon glyphicon-hdd"></span>

            @GetString("admin_storage", "Storage")

        </a>





        <div class="sidebar-footer">

            <strong>
                @Model.AdminName
            </strong>


            <small>
                @Model.AdminRole
            </small>

            <form method="post" action="@Url.Action("Logout","Home")" style="margin-top:8px">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:none;border:1px solid rgba(255,255,255,.3);color:rgba(255,255,255,.7);padding:4px 10px;border-radius:4px;font-size:11px;cursor:pointer">@GetString("admin_logout", "Logout")</button>
            </form>

        </div>


</aside>