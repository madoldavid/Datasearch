        <!-- RECENT UPLOADS -->


        <section class="recent-card">


            <h2>
                Recent Uploads
            </h2>




            @foreach (var file in Model.RecentUploads)
            {


                <div class="file-item">


                    <span class="glyphicon glyphicon-file file-icon"></span>




                    <div class="file-info">


                        <strong>
                            @file.FileName
                        </strong>


                        <small>

                            @file.FileSize -

                            @file.RowCount.ToString("N0") rows -

                            @file.UploadedTime

                        </small>


                    </div>




                    <span class="status-badge">

                        @file.Status

                    </span>



                </div>


            }



        </section>






    </main>


</div>

<script>
    function showFileName(input) {

        const label = document.getElementById("selectedFile");

        if (input.files.length > 0) {
            label.innerHTML =
                '<span class="glyphicon glyphicon-file"></span> ' +
                input.files[0].name;
        }
    }
</script>

@if (TempData["Message"] != null)
{
    <script>

Swal.fire({
    icon: 'Fail',
    title: 'Failed',
    text: '@TempData["Message"]',
    confirmButtonText: 'OK'
});

    </script>
}