    <!-- MAIN CONTENT -->


    <main class="admin-content">



        <!-- HEADER -->


        <div class="page-header">


            <div>

                <h1>
                    Upload Files
                </h1>


                <p>
                    Add new Excel or CSV files to the index
                </p>

            </div>




            <div class="profile-card">


                <span class="glyphicon glyphicon-user"></span>


