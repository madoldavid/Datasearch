                               onchange="showFileNames(this)" />

                        <p id="selectedFile" class="selected-file" style="margin-top:12px;color:#1f6398;font-weight:600;font-size:14px">
                            No files selected
                        </p>
                    </div>

                    <div class="format-tags">
                        <span>.XLSX</span>
                        <span>.XLS</span>
                        <span>.CSV</span>
                    </div>

                    <button type="submit" class="start-upload-btn" id="uploadSubmitBtn">
                        <span class="glyphicon glyphicon-upload"></span>
                        Upload & Start Indexing
                    </button>

                </form>

                <div style="margin-top:20px;padding-top:20px;border-top:1px solid #e5ebf1">
                    <p style="color:#6b7d8e;font-size:13px;margin-bottom:10px">Or scan a folder for new files:</p>
                    <div style="display:flex;gap:8px">
                        <input type="text" id="folderPathInput" class="form-control"
                               style="flex:1;height:42px;border-radius:8px"
                               placeholder="e.g. D:\ExcelSearchApp\Data\"
                               value="@ViewBag.DataFolder" />
                        <button type="button" class="btn btn-default" onclick="scanFolder()"
                                style="height:42px;border-radius:8px;white-space:nowrap">
                            <span class="glyphicon glyphicon-folder-open"></span> Scan & Index
                        </button>
                    </div>
                    <div id="scanResult" style="margin-top:8px;font-size:12px;color:#6b7d8e"></div>
                </div>

            </div>

        </section>


