<script>
    function showFileNames(input) {
        const label = document.getElementById("selectedFile");
        if (input.files.length === 0) {
            label.innerHTML = 'No files selected';
        } else if (input.files.length === 1) {
            label.innerHTML = '<span class="glyphicon glyphicon-file"></span> ' + input.files[0].name;
        } else {
            label.innerHTML = '<span class="glyphicon glyphicon-file"></span> ' + input.files.length + ' files selected';
        }
    }

    var pendingUpload = null;
    function handleUploadSubmit(e) {
        if (pendingUpload) {
            // Already proceeded after duplicate check
            pendingUpload = false;
            return true;
        }
        e.preventDefault();
        var form = document.getElementById('uploadForm');
        var files = document.getElementById('excelFile').files;
        if (!files || files.length === 0) {
            Swal.fire({ icon: 'warning', title: 'No files', text: 'Please select at least one file.' });
            return false;
        }
        // Check duplicates for the first file (the backend handles all)
        var formData = new FormData();
        formData.append('fileName', files[0].name);
        fetch('@Url.Action("CheckDuplicate","Admin")', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.exists) { submitNow(form); return; }
                var msg = 'File "' + data.existingName + '" already exists.\n\n' +
                    'Existing: ' + data.existingSize.toLocaleString() + ' bytes\n' +
                    'New:      ' + data.incomingSize.toLocaleString() + ' bytes\n' +
                    'Hash: ' + (data.sameHash ? 'IDENTICAL' : 'DIFFERENT');
                Swal.fire({
                    title: 'Duplicate File Detected',
                    text: msg,
                    icon: 'warning',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Replace',
                    denyButtonText: 'Keep Both',
                    cancelButtonText: 'Skip'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        // Replace — add duplicateAction=replace
                        var input = document.createElement('input');
                        input.type = 'hidden'; input.name = 'duplicateAction'; input.value = 'replace';
                        form.appendChild(input);
                        submitNow(form);
                    } else if (result.isDenied) {
                        // Keep Both — add duplicateAction=keepboth
                        var input = document.createElement('input');
                        input.type = 'hidden'; input.name = 'duplicateAction'; input.value = 'keepboth';
                        form.appendChild(input);
                        submitNow(form);
                    }
                    // Cancel = skip, do nothing
                });
            })
            .catch(function() { submitNow(form); });
        return false;
    }
    function submitNow(form) { pendingUpload = true; form.submit(); }

    function scanFolder() {
        var folder = document.getElementById('folderPathInput').value.trim();
        if (!folder) { Swal.fire({ icon: 'warning', title: 'Enter a folder path' }); return; }
        var result = document.getElementById('scanResult');
        result.innerHTML = 'Scanning folder...';
        var formData = new FormData();
        formData.append('folderPath', folder);
        fetch('@Url.Action("ScanFolder","Admin")', { method: 'POST', body: formData })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.error) { result.innerHTML = 'Error: ' + data.error; return; }
                result.innerHTML = 'Found ' + data.found + ' new files. Indexed: ' + data.indexed + ', Skipped: ' + data.skipped + ', Failed: ' + data.failed + '.';
            })
            .catch(function(e) { result.innerHTML = 'Failed to scan folder.'; });
    }
</script>

