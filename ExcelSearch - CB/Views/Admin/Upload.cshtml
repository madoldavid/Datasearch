    <!-- MAIN CONTENT -->


    <main class="admin-content">



        <!-- HEADER -->


        <div class="page-header">


            <div>

                <h1>
                    Upload Files
                </h1>


                <p>
                    Add new Excel or CSV files to the index
                </p>

            </div>




            <div class="profile-card">


                <span class="glyphicon glyphicon-user"></span>


                <div>

                    <strong>
                        @Model.AdminName
                    </strong>


                    <small>
                        @Model.AdminRole
                    </small>

                </div>


            </div>


        </div>









        <!-- UPLOAD CARD -->

        <section class="upload-card">

            <div class="drop-zone">

                <span class="glyphicon glyphicon-cloud-upload upload-icon"></span>

                <h3>Drag & drop files here or</h3>

                <form action="@Url.Action("StartIndexing","Admin")"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="file"
                           id="excelFile"
                           name="excelFile"
                           hidden
                           onchange="showFileName(this)" />

                    <label for="excelFile" class="btn-primary">
                        <span class="glyphicon glyphicon-folder-open"></span>
                        Browse Files
                    </label>

                    <p id="selectedFile" class="selected-file">
                        No file selected
                    </p>

                    <div class="format-tags">
                        <span>.XLSX</span>
                        <span>.XLS</span>
                        <span>.CSV</span>
                    </div>

                    <button type="submit" class="start-upload-btn">
                        <span class="glyphicon glyphicon-upload"></span>
                        Upload & Start Indexing
                    </button>

                </form>

            </div>

        </section>


