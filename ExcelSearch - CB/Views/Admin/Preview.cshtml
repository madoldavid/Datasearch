@model List<Dictionary<string, string>>

@{
    ViewBag.Title = "File Preview";
    var adminModel = new ExcelSearch___CB.Models.AdminBaseViewModel
    {
        AdminName = ViewBag.AdminName as string ?? "Administrator",
        AdminRole = ViewBag.AdminRole as string ?? "Admin"
    };
    var headers = Model != null && Model.Count > 0 
        ? Model.First().Keys.Where(k => k != "__source_row__").ToList() 
        : new List<string>();
}

<div class="admin-layout">

    <partial name="_AdminSidebar" model="adminModel" />

    <main class="admin-content">

        <div class="page-header">
            <div>
                <h1>File Preview</h1>
                <p><strong>File:</strong> @ViewBag.FileName</p>
            </div>
            <div>
                <a href="@Url.Action("Search", "Admin")" class="btn btn-default">
                    <span class="glyphicon glyphicon-arrow-left"></span> Back to Search
                </a>
            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-warning">
                No data available to preview.
            </div>
        }
        else
        {
            <div style="background:#fff;border-radius:12px;padding:20px;margin-bottom:20px;border:1px solid #e8edf5;box-shadow:0 4px 12px rgba(0,0,0,.04);">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">
                    <div>
                        <span style="font-weight:600;color:#12375b;">Total Rows Displayed:</span> @Model.Count
                    </div>

                    <div>
                        <a id="exportSelectedLink" 
                           href="@Url.Action("ExportCurrentFile", "Admin", new { path = ViewBag.FilePath, format = "xlsx", grouping = "flat" })" 
                           class="btn btn-success" style="background:#2e9d56;border:none;">
                            <span class="glyphicon glyphicon-export"></span> Export All Rows
                        </a>
                    </div>
                </div>

                <div style="overflow-x:auto;">
                    <table class="table table-striped table-bordered" id="previewTable">
                        <thead>
                            <tr>
                                <th style="width:40px;text-align:center;">
                                    <input type="checkbox" id="selectAllRows" />
                                </th>
                                <th>#</th>
                                @foreach (var h in headers)
                                {
                                    <th>@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowIdx = 0; }
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td style="text-align:center;">
                                        <input type="checkbox" class="row-select-cb" data-row-index="@rowIdx" />
                                    </td>
                                    <td>@(row.ContainsKey("__source_row__") ? row["__source_row__"] : (rowIdx + 1).ToString())</td>
                                    @foreach (var h in headers)
                                    {
                                        <td>@(row.ContainsKey(h) ? row[h] : "")</td>
                                    }
                                </tr>
                                rowIdx++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="preview-pagination-bar" style="display:flex; justify-content:space-between; align-items:center; margin-top:20px; flex-wrap:wrap; gap:15px; border-top:1px solid #e2e8f0; padding-top:15px;">
                    <div class="pagination-info" style="color:#64748b;">
                        Showing <span id="startRange">0</span> to <span id="endRange">0</span> of <span id="totalRowsCount">0</span> rows
                    </div>
                    <div class="pagination-controls" style="display:flex; align-items:center; gap:15px;">
                        <div style="display:flex; align-items:center; gap:5px;">
                            <label for="pageSizeSelect" style="margin:0; font-weight:normal; color:#64748b; white-space:nowrap;">Show:</label>
                            <select id="pageSizeSelect" class="form-control" style="width:auto; display:inline-block; height:34px; padding:6px 12px;">
                                <option value="10">10 rows</option>
                                <option value="25" selected>25 rows</option>
                                <option value="50">50 rows</option>
                                <option value="100">100 rows</option>
                                <option value="all">All rows</option>
                            </select>
                        </div>
                        <nav aria-label="Page navigation" style="display:inline-block;">
                            <ul class="pagination" id="previewPagination" style="margin:0; vertical-align:middle;">
                                <!-- Dynamically populated by JS -->
                            </ul>
                        </nav>
                    </div>
                </div>

            </div>
        }

    </main>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const table = document.getElementById("previewTable");
    if (!table) return;

    const tbody = table.querySelector("tbody");
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll("tr"));
    if (rows.length === 0) return;

    const selectAll = document.getElementById("selectAllRows");
    const rowCbs = tbody.querySelectorAll(".row-select-cb");
    const pageSizeSelect = document.getElementById("pageSizeSelect");
    const previewPagination = document.getElementById("previewPagination");
    const startRangeSpan = document.getElementById("startRange");
    const endRangeSpan = document.getElementById("endRange");
    const totalRowsCountSpan = document.getElementById("totalRowsCount");
    const exportBtn = document.getElementById("exportSelectedLink");
    const basePath = "@Url.Action("ExportCurrentFile", "Admin", new { path = ViewBag.FilePath, format = "xlsx", grouping = "flat" })";

    let currentPage = 1;
    let pageSize = parseInt(pageSizeSelect.value) || 25;

    function renderTable() {
        const totalRows = rows.length;
        totalRowsCountSpan.textContent = totalRows;

        let totalPages = 1;
        if (pageSize === -1) {
            totalPages = 1;
            currentPage = 1;
        } else {
            totalPages = Math.ceil(totalRows / pageSize);
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
        }

        const startIndex = pageSize === -1 ? 0 : (currentPage - 1) * pageSize;
        const endIndex = pageSize === -1 ? totalRows : Math.min(startIndex + pageSize, totalRows);

        startRangeSpan.textContent = totalRows > 0 ? startIndex + 1 : 0;
        endRangeSpan.textContent = endIndex;

        rows.forEach((row, idx) => {
            if (pageSize === -1 || (idx >= startIndex && idx < endIndex)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });

        renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
        previewPagination.innerHTML = "";
        if (totalPages <= 1) return;

        // Previous button
        const prevLi = document.createElement("li");
        if (currentPage === 1) prevLi.classList.add("disabled");
        const prevLink = document.createElement("a");
        prevLink.href = "#";
        prevLink.innerHTML = "&laquo;";
        prevLink.addEventListener("click", function (e) {
            e.preventDefault();
            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        });
        prevLi.appendChild(prevLink);
        previewPagination.appendChild(prevLi);

        // Page numbers
        const maxPageButtons = 5;
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + maxPageButtons - 1);
        if (endPage - startPage < maxPageButtons - 1) {
            startPage = Math.max(1, endPage - maxPageButtons + 1);
        }

        if (startPage > 1) {
            const firstLi = document.createElement("li");
            const firstLink = document.createElement("a");
            firstLink.href = "#";
            firstLink.textContent = "1";
            firstLink.addEventListener("click", function (e) {
                e.preventDefault();
                currentPage = 1;
                renderTable();
            });
            firstLi.appendChild(firstLink);
            previewPagination.appendChild(firstLi);

            if (startPage > 2) {
                const ellLi = document.createElement("li");
                ellLi.classList.add("disabled");
                const ellSpan = document.createElement("span");
                ellSpan.textContent = "...";
                ellLi.appendChild(ellSpan);
                previewPagination.appendChild(ellLi);
            }
        }

        for (let p = startPage; p <= endPage; p++) {
            const pageLi = document.createElement("li");
            if (p === currentPage) pageLi.classList.add("active");
            const pageLink = document.createElement("a");
            pageLink.href = "#";
            pageLink.textContent = p;
            pageLink.addEventListener("click", function (e) {
                e.preventDefault();
                currentPage = p;
                renderTable();
            });
            pageLi.appendChild(pageLink);
            previewPagination.appendChild(pageLi);
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                const ellLi = document.createElement("li");
                ellLi.classList.add("disabled");
                const ellSpan = document.createElement("span");
                ellSpan.textContent = "...";
                ellLi.appendChild(ellSpan);
                previewPagination.appendChild(ellLi);
            }

            const lastLi = document.createElement("li");
            const lastLink = document.createElement("a");
            lastLink.href = "#";
            lastLink.textContent = totalPages;
            lastLink.addEventListener("click", function (e) {
                e.preventDefault();
                currentPage = totalPages;
                renderTable();
            });
            lastLi.appendChild(lastLink);
            previewPagination.appendChild(lastLi);
        }

        // Next button
        const nextLi = document.createElement("li");
        if (currentPage === totalPages) nextLi.classList.add("disabled");
        const nextLink = document.createElement("a");
        nextLink.href = "#";
        nextLink.innerHTML = "&raquo;";
        nextLink.addEventListener("click", function (e) {
            e.preventDefault();
            if (currentPage < totalPages) {
                currentPage++;
                renderTable();
            }
        });
        nextLi.appendChild(nextLink);
        previewPagination.appendChild(nextLi);
    }

    pageSizeSelect.addEventListener("change", function () {
        const val = this.value;
        if (val === "all") {
            pageSize = -1;
        } else {
            pageSize = parseInt(val) || 25;
        }
        currentPage = 1;
        renderTable();
    });

    function updateExportUrl() {
        const selected = [];
        rowCbs.forEach(cb => {
            if (cb.checked) {
                selected.push(cb.getAttribute("data-row-index"));
            }
        });

        if (selected.length > 0) {
            exportBtn.href = basePath + "&selectedRows=" + selected.join(",");
            exportBtn.innerHTML = '<span class="glyphicon glyphicon-export"></span> Export Selected (' + selected.length + ')';
        } else {
            exportBtn.href = basePath;
            exportBtn.innerHTML = '<span class="glyphicon glyphicon-export"></span> Export All Rows';
        }
    }

    if (selectAll) {
        selectAll.addEventListener("change", function () {
            rowCbs.forEach(cb => {
                cb.checked = selectAll.checked;
                cb.closest("tr").classList.toggle("selected", selectAll.checked);
            });
            updateExportUrl();
        });
    }

    rowCbs.forEach(cb => {
        cb.addEventListener("change", function () {
            this.closest("tr").classList.toggle("selected", this.checked);

            if (!this.checked) {
                selectAll.checked = false;
            } else {
                const allChecked = Array.from(rowCbs).every(c => c.checked);
                selectAll.checked = allChecked;
            }
            updateExportUrl();
        });
    });

    renderTable();
});
</script>
