    <main class="admin-content">


        <div class="page-header">


            <div>

                <h1>
                    All Files
                </h1>


                <p>
                    Manage indexed Excel and CSV documents
                </p>


            </div>



            <div class="profile-card">

                <span class="glyphicon glyphicon-user"></span>

                <div>

                    <strong>
                        @Model.AdminName
                    </strong>

                    <small>
                        @Model.AdminRole
                    </small>

                </div>

            </div>


        </div>









        <div class="file-summary-card">


            <div>

                <span class="glyphicon glyphicon-folder-open"></span>


                <div>

                    <h3>
                        @Model.TotalFiles
                    </h3>


                    <p>
                        @Model.SummaryText
                    </p>


                </div>


            </div>


        </div>








        <section class="files-card">


            <div class="files-header">


                <h2>
                    Files
                </h2>


                <input class="file-search"
                       placeholder="Search files..." />


            </div>





            <table class="files-table">


                <thead>

                    <tr>
                        <th>File Name</th>
                        <th>Type</th>
                        <th>Size</th>
                        <th>Rows</th>
                        <th>Status</th>
                        <th>Last Indexed</th>
                        <th>Actions</th>
                    </tr>


                </thead>



                <tbody>


                    @foreach (var file in Model.Files)
                    {


                        <tr>


                            <td>
                                <span class="glyphicon glyphicon-file file-icon"></span>
                                <strong>@file.FileName</strong>
                            </td>
                            <td>@(file.FileName.EndsWith(".csv") ? "CSV" : "Excel")</td>
                            <td>@file.FileSize</td>
                            <td>@file.Records.ToString("N0")</td>
                            <td><span class="file-status">@file.Status</span></td>
                            <td>@file.LastIndexed</td>


                            <td>

                                <form method="post" action="@Url.Action("ViewFile","Admin")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@file.FileName" />
                                    <button type="submit" class="action-btn">View</button>
                                </form>

                                <form method="post" action="@Url.Action("ReindexFile","Admin")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@file.FileName" />
                                    <button type="submit" class="action-btn">Re-Index</button>
                                </form>

                                <form method="post" action="@Url.Action("DeleteFile","Admin")" style="display:inline"
                                      onsubmit="return confirm('PERMANENTLY DELETE: @file.FileName?\n\nFile: @file.FileName\nRecords: @file.Records.ToString("N0")\nSize: @file.FileSize\n\nThis will delete both the physical file and all indexed records. Type DELETE in the next prompt to confirm.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@file.FileName" />
                                    <button type="submit" class="action-btn danger">Delete</button>
                                </form>

                            </td>



                        </tr>


                    }



                </tbody>


            </table>


        </section>



    </main>


</div>