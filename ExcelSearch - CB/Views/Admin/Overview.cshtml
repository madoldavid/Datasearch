@model ExcelSearch___CB.Models.OverviewViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    var config = ViewBag.AppConfig as ExcelSearch___CB.Data.AppConfig;
    var strings = ViewBag.UIStrings as System.Collections.Generic.Dictionary<string, string> ?? new System.Collections.Generic.Dictionary<string, string>();
    
    string GetString(string key, string defaultValue = "") {
        return strings.ContainsKey(key) ? strings[key] : defaultValue;
    }
}


<div class="admin-layout">


    <!-- SIDEBAR -->
    @*<aside class="admin-sidebar">*@

        <partial name="_AdminSidebar" model="Model" />


    <!-- MAIN CONTENT -->

    <main class="admin-content">


        <!-- HEADER -->

        <div class="page-header">


            <div>

                <h1>
                    @GetString("admin_overview_title", "Admin Dashboard")
                </h1>


                <p>
                    @GetString("admin_overview_subtitle", "System health and pipeline status")
                </p>

            </div>



            <div class="profile-card">

                <span class="glyphicon glyphicon-user"></span>


                <div>

                    <strong>
                        @Model.AdminName
                    </strong>


                    <small>
                        @Model.AdminRole
                    </small>

                </div>


            </div>


        </div>







        <!-- SYSTEM ALERT -->


        <div class="system-alert" style="background:@(Model.FailedFiles > 0 ? "#fff7f7" : "#e9f8ee");color:@(Model.FailedFiles > 0 ? "#c82333" : "#237b45")">

            <span class="glyphicon @(Model.FailedFiles > 0 ? "glyphicon-warning-sign" : "glyphicon-ok-circle")"></span>

            System Overview —
            @(Model.FailedFiles > 0 ? Model.FailedFiles + " " + GetString("admin_overview_alert_error", "files need attention") : GetString("admin_overview_alert_ok", "All systems operational")) —
            @GetString("admin_overview_last_index", "last index:")
            @Model.LastIndexTime.ToString("hh:mm tt")

        </div>







        <!-- METRIC CARDS -->


        <div class="metrics-grid">



            <div class="metric-card">

                <span class="glyphicon glyphicon-file icon"></span>


                <h3>
                    @GetString("admin_metric_files", "Files Indexed")
                </h3>


                <strong>
                    @Model.FilesIndexed
                </strong>


                <p>
                    @Model.FilesIndexedDescription
                </p>


            </div>







            <div class="metric-card">


                <span class="glyphicon glyphicon-list-alt icon"></span>


                <h3>
                    @GetString("admin_metric_records", "Total Records")
                </h3>


                <strong>
                    @Model.TotalRecords.ToString("N0")
                </strong>


                <p>
                    @Model.TotalRecordsDescription
                </p>


            </div>








            <div class="metric-card warning-card">


                <span class="glyphicon glyphicon-warning-sign icon"></span>


                <h3>
                    @GetString("admin_metric_failed", "Failed Files")
                </h3>


                <strong>
                    @Model.FailedFiles
                </strong>


                <p>
                    @Model.FailedFilesDescription
                </p>


            </div>








            <div class="metric-card">


                <span class="glyphicon glyphicon-hdd icon"></span>


                <h3>
                    @GetString("admin_metric_storage", "Storage Used")
                </h3>


                <strong>

                    @Model.StorageUsed GB

                </strong>


                <p>

                    @GetString("admin_metric_storage_of", "of") @Model.StorageLimit GB

                </p>


            </div>



        </div>









        <!-- PIPELINE CARD -->


        <section class="pipeline-card">


            <div class="pipeline-header">


                <h2>
                    @GetString("admin_pipeline_title", "Admin Pipeline Status")
                </h2>



                <a href="@Url.Action("Upload","Admin")" class="btn-primary" style="text-decoration:none;display:inline-block;cursor:pointer;color:#fff;">

                    <span class="glyphicon glyphicon-upload"></span>

                    @GetString("admin_pipeline_upload", "Upload New Files")

                </a>


            </div>







            <div class="pipeline-flow">



                @foreach (var stage in Model.PipelineStages)
                {

                    <div class="pipeline-step">


                        <div class="step-circle" style="background:@(stage.Status == "Complete" || stage.Status == "Ready" ? "#1f6398" : "#94a3b8")">

                            <span class="glyphicon @(stage.Status == "Complete" || stage.Status == "Ready" ? "glyphicon-ok" : "glyphicon-time")"></span>

                        </div>



                        <h4>
                            @stage.StageName
                        </h4>



                        <p>
                            @stage.Details
                        </p>



                        <small>
                            @stage.Status
                        </small>


                    </div>


                }



            </div>






        </section>







        <div class="failed-link">


            <span class="glyphicon glyphicon-warning-sign"></span>


            <a href="@Url.Action("FailedFiles","Admin")">
                @GetString("admin_view_failed", "View Failed Files")
            </a>


        </div>




    </main>



</div>