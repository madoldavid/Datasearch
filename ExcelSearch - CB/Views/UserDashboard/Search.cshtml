    <main class="dashboard-main search-page">
        <div class="mobile-header">
            <strong>Excel Search Pro</strong>

            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open navigation menu">
                &#9776;
            </button>
        </div>

        <header class="page-header">
            <div>
                <h1>Search</h1>
                <p>Query across all @(ViewBag.FilesIndexed ?? 0) indexed files.</p>
            </div>

            <a href="@Url.Action("Index", "Home")" class="top-back-button">
                &#8592; Landing Page
            </a>
        </header>

        <section class="search-workspace">
            <div class="search-card">
                <h2>Search your real estate data</h2>
                <p class="search-card-description">
                    Search by building, unit, owner, price, or any indexed Excel column.
                </p>

                <div class="search-form-row">

                    <form method="post"
                          action="@Url.Action("Search","UserDashboard")"
                          class="search-form">

                        <div class="search-text-wrapper">

                            <span class="search-symbol">&#128269;</span>

                            <input type="text"
                                   name="searchText"
                                   id="mainSearchInput"
                                   class="form-control"
                                    value="@ViewBag.SearchText"
                                   placeholder="e.g. Marina Tower, Apartment 201, Ahmed..." />

                        </div>


                        <select name="searchColumn"
                                class="form-control search-column-select">

                            <option value="All">All Columns</option>
                            @if (ViewBag.Columns != null)
                            {
                                foreach (string col in ViewBag.Columns)
                                {
                                    <option value="@col">@col</option>
                                }
                            }

                        </select>


                        <div class="search-action-buttons">


                            <button type="submit"
                                    class="btn btn-primary search-submit-button">

                                <span class="glyphicon glyphicon-search"></span>

                                Search

                            </button>



                            <a href="@Url.Action("FilterBuilder","UserDashboard")"
                               class="btn btn-default filter-builder-button">

                                <span class="glyphicon glyphicon-filter"></span>

                                Filter Builder

                            </a>


                        </div>


                    <div class="search-mode-section">
                        <span class="mode-label">SEARCH MODE</span>

                        <label class="search-radio">
                            <input type="radio" name="searchMode" value="Exact" />
                            <span>Exact</span>
                            <small>Full word match</small>
                        </label>

                        <label class="search-radio">
                            <input type="radio" name="searchMode" value="Partial" checked="checked" />
                            <span>Partial</span>
                            <small>Contains text</small>
                        </label>

                        <label class="search-radio">
                            <input type="radio" name="searchMode" value="Flexible" />
                            <span>Flexible</span>
                            <small>Fuzzy match</small>
                        </label>
                    </div>

                    </form>

                </div>
            </div>





            <section class="recent-searches">
                <div class="section-heading">
                    <div>
                        <h2>Recent Searches</h2>
                        <p>Quickly run a previous search again.</p>
                    </div>
                </div>

                <div class="recent-search-list">
                    @if (ViewBag.RecentSearches != null)
                    {
                        var recentIcons = new[] { "&#128269;", "&#128176;", "&#127968;", "&#128202;", "&#127978;" };
                        int idx = 0;
                        foreach (dynamic rs in ViewBag.RecentSearches)
                        {
                            <button type="button" class="recent-search-item" data-search="@rs.Term">
                                <span class="recent-icon">@Html.Raw(recentIcons[idx % recentIcons.Length])</span>
                                <span class="recent-search-content">
                                    <strong>@rs.Term</strong>
                                    <small>@rs.Mode · @rs.Column</small>
                                </span>
                                <span class="recent-arrow">&#8594;</span>
                            </button>
                            idx++;
                        }
                    }
                </div>
            </section>
        </section>
    </main>
</div>

<script>
    (function () {
        var menuToggle = document.getElementById("menuToggle");
        var dashboardSidebar = document.getElementById("dashboardSidebar");
       /* var searchButton = document.getElementById("searchButton");*/
        var mainSearchInput = document.getElementById("mainSearchInput");
        var recentSearchItems = document.querySelectorAll(".recent-search-item");

        menuToggle.addEventListener("click", function () {
            dashboardSidebar.classList.toggle("open");
        });



    @*searchButton.addEventListener("click", function () {
            if (mainSearchInput.value.trim() === "") {
                mainSearchInput.focus();
                 return;
         }

         window.location.href = '@Url.Action("FilterBuilder", "UserDashboard")';
         });*@

        mainSearchInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                searchButton.click();
            }
        });

        for (var i = 0; i < recentSearchItems.length; i++) {
            recentSearchItems[i].addEventListener("click", function () {
                mainSearchInput.value = this.getAttribute("data-search");
                mainSearchInput.focus();
            });
        }
    })();
</script>

@if (TempData["SearchError"] != null)
{
    <script>
        Swal.fire({
            icon: 'info',
            title: 'No Results',
            text: '@TempData["SearchError"]'
        });
    </script>
}