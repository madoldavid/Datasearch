    <main class="dashboard-main">
        <div class="mobile-header">
            <strong>Excel Search Pro</strong>
            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open navigation menu">
                <span class="glyphicon glyphicon-menu-hamburger"></span>
            </button>
        </div>

        <header class="dashboard-topbar">
            <div>
                <h1>
                    <span class="glyphicon glyphicon-user"></span>
                    Hello, @ViewBag.UserName
                </h1>
                <p>Here is your real estate data workspace overview.</p>
            </div>

            @*<div class="user-status">
                    <span class="user-avatar">A</span>
                    <div>
                        <strong>Analyst</strong>
                        <span>Read + Export</span>
                    </div>
                </div>*@

            <a href="@Url.Action("Index", "Home")" class="top-back-button">
                &#8592; Landing Page
            </a>
        </header>

        <div class="index-status">
            <span class="glyphicon glyphicon-ok-circle"></span>
            <span>The index is up to date. @ViewBag.FilesIndexed files ready to search.</span>
        </div>

        <section class="row">
            <div class="col-sm-6 col-lg-3">
                <div class="metric-card">
                    <div class="metric-card-header">
                        <span>FILES INDEXED</span>
                        <span class="metric-icon glyphicon glyphicon-folder-open"></span>
                    </div>
                    <div class="metric-number">@ViewBag.FilesIndexed</div>
                    <div class="metric-detail">Indexed files</div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="metric-card">
                    <div class="metric-card-header">
                        <span>TOTAL RECORDS</span>
                        <span class="metric-icon glyphicon glyphicon-list"></span>
                    </div>
                    <div class="metric-number">@ViewBag.TotalRecords.ToString("N0")</div>
                    <div class="metric-detail">Last indexed today</div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="metric-card">
                    <div class="metric-card-header">
                        <span>MY EXPORTS</span>
                        <span class="metric-icon glyphicon glyphicon-export"></span>
                    </div>
                    <div class="metric-number">@ViewBag.MyExports</div>
                    <div class="metric-detail">This month</div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="metric-card">
                    <div class="metric-card-header">
                        <span>SEARCHES TODAY</span>
                        <span class="metric-icon glyphicon glyphicon-flash"></span>
                    </div>
                    <div class="metric-number">@ViewBag.SearchesToday</div>
                    <div class="metric-detail">Searches today</div>
                </div>
            </div>
        </section>

        <section class="dashboard-panel">
            <h2 class="panel-title">Start a new search</h2>
            <p class="panel-subtitle">Search across indexed real estate records and Excel files.</p>

            <div class="search-box">
                <span class="glyphicon glyphicon-search search-input-icon"></span>
                <input type="text"
                       class="form-control"
                       id="dashboardSearch"
                       placeholder="Search by building, unit, owner, price, or any column" />
                <button type="button" class="btn btn-primary" id="searchButton">
                    <span class="glyphicon glyphicon-search"></span>
                    Search
                </button>
            </div>

            <div class="quick-actions">
                @if (ViewBag.TopSearches != null)
                {
                    var icons = new[] { "glyphicon-map-marker", "glyphicon-home", "glyphicon-usd", "glyphicon-ok-circle" };
                    int i = 0;
                    foreach (string term in ViewBag.TopSearches)
                    {
                        <a href="@Url.Action("Search", "UserDashboard", new { searchText = term })" class="quick-action">
                            <span class="glyphicon @(icons[i % icons.Length])"></span>
                            @term
                        </a>
                        i++;
                    }
                }
            </div>
        </section>

        <section class="dashboard-panel">
            <h2 class="panel-title">Recent Activity</h2>
            <p class="panel-subtitle">Your latest search and export activity.</p>

            <ul class="activity-list">
                @if (ViewBag.Activities != null)
                {
                    foreach (dynamic activity in ViewBag.Activities)
                    {
                        if (activity.Type == "search")
                        {
                            <li>
                                <span class="activity-icon glyphicon glyphicon-search"></span>
                                <div class="activity-text">
                                    Searched <strong>"@activity.Text"</strong>
                                    <span class="activity-time">@activity.TimeAgo</span>
                                </div>
                            </li>
                        }
                        else if (activity.Type == "export")
                        {
                            <li>
                                <span class="activity-icon glyphicon glyphicon-export"></span>
                                <div class="activity-text">
                                    Exported @activity.Count rows → <strong>@activity.Text</strong>
                                    <span class="activity-time">@activity.TimeAgo</span>
                                </div>
                            </li>
                        }
                    }
                }

                @if (ViewBag.Activities == null || ((System.Collections.IList)ViewBag.Activities).Count == 0)
                {
                    <li>
                        <span class="activity-icon glyphicon glyphicon-info-sign"></span>
                        <div class="activity-text">
                            No activity yet. <strong>Start searching</strong> to see your history here.
                            <span class="activity-time">Get started</span>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </main>
</div>

<script>
(function () {

    var menuToggle = document.getElementById("menuToggle");
    var dashboardSidebar = document.getElementById("dashboardSidebar");
    var searchButton = document.getElementById("searchButton");
    var dashboardSearch = document.getElementById("dashboardSearch");


    if (menuToggle && dashboardSidebar) {

        menuToggle.addEventListener("click", function () {
            dashboardSidebar.classList.toggle("open");
        });

    }



    searchButton.addEventListener("click", function () {

        var searchValue = dashboardSearch.value.trim();


        if (searchValue === "") {

            Swal.fire({
                icon: "warning",
                title: "Search required",
                text: "Please enter something to search."
            });

            return;
        }



        window.location.href =
            '@Url.Action("Search", "UserDashboard")'
            + '?searchText='
            + encodeURIComponent(searchValue);


    });



    dashboardSearch.addEventListener("keypress", function (event) {

        if (event.key === "Enter") {

            searchButton.click();

        }

    });


})();
</script>